@model Ween.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
}

<div class="wrap">
    <header class="site-header">
        <div class="brand"><span class="brand-mark">Ween</span><span class="brand-name">Admin</span></div>
        <nav class="crumbs">
            <a asp-controller="Home" asp-action="Index">Directory</a>
            <span class="sep">/</span>
            <span class="current">Admin</span>
        </nav>
    </header>
</div>
<div class="mosaic-band"></div>

<div class="wrap">
    <section class="hero" style="padding-bottom:6px;">
        <div class="hero-eyebrow">One form, every category</div>
        <h1>Register <em>any</em> place</h1>
        <p>Manage the category list, then add a new place — the form below adapts its fields to whichever category is selected.</p>
        <a class="back-link" asp-action="Reservations">View all reservations across every user →</a>
    </section>

    @if (TempData["AdminMsg"] != null)
    {
        <div class="admin-confirm show" style="max-width:640px;">@TempData["AdminMsg"]</div>
    }

    <div class="admin-layout">
        <div class="admin-left-stack">
            <div class="admin-panel">
                <h3>Cities</h3>
                <div class="admin-sub">Add a new city and it appears on the homepage, and as an option in the form on the right.</div>
                <div class="chip-list">
                    @foreach (var c in Model.Cities)
                    {
                        <span class="chip">@c.Name@(string.IsNullOrEmpty(c.LocalName) ? "" : $" ({c.LocalName})")</span>
                    }
                </div>
                <form asp-action="AddCity" method="post" class="add-chip-row">
                    <input type="text" name="Name" placeholder="City name, e.g. Mecca" required>
                    <input type="text" name="LocalName" placeholder="Local name (optional)" style="max-width:160px;">
                    <button type="submit">Add</button>
                </form>
            </div>

            <div class="admin-panel">
                <h3>Categories</h3>
                <div class="admin-sub">Add a new category and it appears everywhere immediately — city pages, listings, the form on the right.</div>
                <div class="chip-list">
                    @foreach (var c in Model.Categories)
                    {
                        <span class="chip"><span class="chip-icon">@c.Icon</span>@c.Name</span>
                    }
                </div>
                <form asp-action="AddCategory" method="post" class="add-chip-row">
                    <input type="text" name="Icon" placeholder="Icon (e.g. 🚕)" style="max-width:110px;">
                    <input type="text" name="Name" placeholder="Category name, e.g. Car Rentals" required>
                    <button type="submit">Add</button>
                </form>
            </div>
        </div>

        <div class="admin-panel">
            <h3>Register a place</h3>
            <div class="admin-sub">One dynamic form for coffee shops, restaurants, hotels, transport — or any category you add.</div>
            <form asp-action="CreatePlace" method="post" enctype="multipart/form-data">
                <div class="field-row2">
                    <div class="field">
                        <label for="CityId">City</label>
                        <select id="CityId" name="CityId">
                            @foreach (var c in Model.Cities)
                            {
                                <option value="@c.CityId">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="CategoryId">Category</label>
                        <select id="CategoryId" name="CategoryId" onchange="renderDynamicFields()">
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.CategoryId">@c.Icon @c.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field"><label for="Name">Place name</label><input type="text" id="Name" name="Name" placeholder="e.g. Rumi Coffee House" required></div>
                <div class="field-row2">
                    <div class="field"><label for="Address">Address</label><input type="text" id="Address" name="Address" placeholder="Street, area" required></div>
                    <div class="field"><label for="Phone">Phone</label><input type="text" id="Phone" name="Phone" placeholder="+962 …"></div>
                </div>
                <div class="field"><label for="LocationUrl">Location link</label><input type="url" id="LocationUrl" name="LocationUrl" placeholder="Paste a Google Maps link, e.g. https://maps.app.goo.gl/…"></div>
                <div class="field-row2">
                    <div class="field"><label for="Hours">Hours</label><input type="text" id="Hours" name="Hours" placeholder="8:00 AM – 11:00 PM"></div>
                    <div class="field"><label for="Tag">Short tag</label><input type="text" id="Tag" name="Tag" placeholder="Cozy, Budget, Fine dining…"></div>
                </div>
                <div class="field"><label for="Capacity">Daily capacity (guests)</label><input type="number" id="Capacity" name="Capacity" value="40" min="1" max="10000"></div>
                <div class="field"><label for="Description">Description</label><textarea id="Description" name="Description" placeholder="What makes this place worth listing?"></textarea></div>

                <div class="field">
                    <label>Photos</label>
                    <div class="photo-upload-box" onclick="document.getElementById('Photos').click()">
                        <input type="file" id="Photos" name="Photos" accept="image/*" multiple onchange="previewPhotos(event)">
                        <div class="photo-upload-label"><strong>Click to add photos</strong> — one, two, or more</div>
                    </div>
                    <div class="photo-preview-grid" id="photoPreviewGrid"></div>
                    <div class="photo-count-note" id="photoCountNote">No photos added yet.</div>
                </div>

                <div class="dynamic-fields" id="dynamicFields">
                    @if (Model.InitialFields.Count > 0)
                    {
                        <div class="dyn-label">Fields specific to this category</div>
                        @foreach (var f in Model.InitialFields)
                        {
                            <div class="field">
                                <label>@f.Label</label>
                                @if (f.FieldType == "select")
                                {
                                    <select name="FieldValues[@f.CategoryFieldId]">
                                        @foreach (var o in f.Options)
                                        {
                                            <option>@o</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" name="FieldValues[@f.CategoryFieldId]">
                                }
                            </div>
                        }
                    }
                </div>

                <button type="submit" class="admin-submit">Register place</button>
            </form>
        </div>
    </div>
</div>

<hr class="mosaic-rule" style="margin-top:60px;">
<div class="wrap">
    <footer class="site-footer">
        <span>ween — a directory of Jordan</span>
        <a asp-controller="Home" asp-action="Index">All cities</a>
    </footer>
</div>

@section Scripts {
    <script>
        function renderDynamicFields() {
            const catId = document.getElementById('CategoryId').value;
            const box = document.getElementById('dynamicFields');
            const esc = s => String(s).replace(/[&<>"']/g, c =>
                ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            fetch(`/Admin/CategoryFields?categoryId=${catId}`)
                .then(r => r.json())
                .then(fields => {
                    if (!fields.length) { box.innerHTML = ''; return; }
                    box.innerHTML = '<div class="dyn-label">Fields specific to this category</div>' +
                        fields.map(f => {
                            const name = `FieldValues[${f.categoryFieldId}]`;
                            const control = f.fieldType === 'select'
                                ? `<select name="${name}">${f.options.map(o => `<option>${esc(o)}</option>`).join('')}</select>`
                                : `<input type="text" name="${name}">`;
                            return `<div class="field"><label>${esc(f.label)}</label>${control}</div>`;
                        }).join('');
                })
                .catch(() => { box.innerHTML = ''; });
        }

        function previewPhotos(e) {
            const grid = document.getElementById('photoPreviewGrid');
            const note = document.getElementById('photoCountNote');
            const files = Array.from(e.target.files || []);
            grid.innerHTML = '';
            files.forEach((file, i) => {
                const reader = new FileReader();
                reader.onload = ev => {
                    const div = document.createElement('div');
                    div.className = 'photo-preview';
                    div.innerHTML = `<img src="${ev.target.result}" alt="Preview ${i + 1}">`;
                    grid.appendChild(div);
                };
                reader.readAsDataURL(file);
            });
            note.textContent = files.length === 0 ? 'No photos added yet.'
                : files.length === 1 ? '1 photo selected.' : `${files.length} photos selected.`;
        }
    </script>
}
