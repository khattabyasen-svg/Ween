@model Ween.Models.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="wrap">
    <header class="site-header">
        <div class="brand"><span class="brand-mark">Ween</span><span class="brand-name">Register</span></div>
        <nav class="crumbs">
            <a asp-controller="Home" asp-action="Index">Directory</a>
            <span class="sep">/</span>
            <span class="current">Register</span>
        </nav>
    </header>
</div>
<div class="mosaic-band"></div>

<div class="auth-shell">
    <div class="auth-card">
        <div class="hero-eyebrow">New here</div>
        <h1>Create your account</h1>
        <div class="auth-sub">Book tables and rooms, and track every reservation in one place.</div>

        <div asp-validation-summary="All" class="auth-error @(ViewData.ModelState.IsValid ? "" : "show")"></div>

        <form asp-controller="Account" asp-action="Register" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="field">
                <label asp-for="FullName">Full name</label>
                <input asp-for="FullName" type="text" placeholder="Yaseen Khattab">
            </div>
            <div class="field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" placeholder="you@example.com">
            </div>
            <div class="field">
                <label asp-for="PhoneNumber">Phone</label>
                <input asp-for="PhoneNumber" type="text" placeholder="+962 7…">
            </div>
            <div class="field">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="••••••••">
            </div>
            <button type="submit" class="res-submit">Create account</button>
        </form>

        <div class="auth-switch">Already have an account? <a asp-controller="Account" asp-action="Login">Log in</a></div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
